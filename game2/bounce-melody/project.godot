; Engine configuration file.
; It's best edited using the editor UI and not directly, since the
; parameters that go here are not all obvious.
;
; This file is hand-authored (no interactive Godot editor was used to
; build this project — see docs/game2.md, "Procedurally-built scene
; tree, not hand-authored .tscn files") — kept to the small set of keys
; that actually matter for a headless Web export.

config_version=5

[application]

config/name="Bounce Melody"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

ItemCatalog="*res://scripts/item_catalog.gd"
ToneEngine="*res://scripts/tone_engine.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="portrait"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05, 0.07, 0.1, 1)
